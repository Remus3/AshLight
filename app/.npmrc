; OVL-NPM-LOCK (F-037): npm never runs a package script, never installs
; past the engines field, saves exact pins only, and names AshLight in its
; requests (the User-Agent floor rule, strict reading). The user-agent line
; carries the release stamp, so 'release.py bump' moves its version with
; server/al/__init__.py VERSION; npm drops the inline ';' comment.
ignore-scripts=true
engine-strict=true
save-exact=true
user-agent=AshLight/0.1.0 npm/{npm-version} node/{node-version} ; al-version-stamp
